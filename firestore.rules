rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: verifica se o usuário logado é admin
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Health check — leitura pública para o badge de status na tela de login
    match /_health/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Usuários — qualquer autenticado pode ler (necessário para busca por email)
    // Apenas o próprio usuário pode criar/editar seu documento (ou admin)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Corridas — autenticados podem ler, apenas admins criam/deletam
    // participantCount pode ser atualizado por qualquer autenticado (via registrationService)
    match /races/{raceId} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (request.auth != null &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantCount']));
    }

    // Inscrições — autenticados podem ler e criar a própria inscrição
    // Apenas admins podem atualizar status
    match /registrations/{registrationId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Rastreamento — autenticados leem (para o placar), próprio usuário escreve
    match /race_tracking/{trackingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }
  }
}
